# Use the 'slim' base for better compatibility with native modules
FROM node:25-slim

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Layer Caching: Only install dependencies if they change
# This keeps the 'make re' cycle fast.
COPY package.json pnpm-lock.yaml ./

# We install ALL dependencies (including devDependencies like Vite/Vue-server-renderer)
# Note: We do NOT use --frozen-lockfile here so you can add packages as you develop.
RUN CI=true pnpm install
# COPY . .

# Port for the SSR server
EXPOSE 3000

CMD ["pnpm", "run", "dev"]